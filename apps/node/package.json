{
	"name": "japari-node",
	"version": "1.0.0",
	"type": "module",
	"description": "Koa 服务：图片生成 + 定时触发（调 Worker）",
	"scripts": {
		"build": "swc src -d dist --strip-leading-paths",
		"start": "npm run build && node ./built/index.js",
		"start:dev": "NODE_ENV=dev node ./built/index.js",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"format": "biome format --write src"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.0.0",
		"@koa/router": "^15.0.0",
		"@napi-rs/canvas": "^0.1.84",
		"axios": "^1.13.2",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"koa": "^2.16.3",
		"koa-body": "^6.0.1",
		"node-schedule": "^2.1.1",
		"pino": "^9.6.0",
		"pino-pretty": "^13.0.0"
	},
	"devDependencies": {
		"@swc/cli": "^0.5.0",
		"@swc/core": "^1.10.1"
	}
}

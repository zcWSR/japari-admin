{
  "name": "japari-worker",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "QQ 机器人 + 管理后台，Next.js App Router + OpenNext 单 Worker",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --config wrangler.dev.toml",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
